#!/bin/sh
# Abort refreshes that would run a different VillageSQL codebase (mysql-8.4,
# mysql-9.7, percona-8.4) on the existing data directory: upstream has no
# in-place migration between codebases and the server refuses to start on
# foreign data. A non-zero exit makes snapd roll back to the previous
# revision. Upgrades within a codebase (0.0.6 -> 0.0.7, 8.4.x -> 8.4.y) are
# handled by mysqld itself at start-up (--upgrade=AUTO). No epoch is used,
# for the same reason as in postgresql-snap: a future in-place migration
# should not have to step through every intermediate release.
set -eu
. "$SNAP/bin/codebase.sh"

datadir="$SNAP_COMMON/data"

if [ ! -d "$datadir/mysql" ]; then
  echo "ERROR: No initialized data directory in $datadir. Refresh aborted, rolling back." >&2
  exit 1
fi

new="$(snap_codebase)"
if ! old="$(data_codebase)"; then
  echo "ERROR: neither $SNAP_COMMON/.snap-data-codebase nor a usable $SNAP_COMMON/.snap-data-major found, \
cannot tell which codebase the data belongs to. Refresh aborted, rolling back." >&2
  exit 1
fi

if [ "$old" != "$new" ]; then
  echo "ERROR: Data in $datadir is from codebase $old but this revision provides $new. \
VillageSQL has no in-place migration between codebases: dump with villagesql.mysqldump, install the \
new track and restore. Refresh aborted, rolling back." >&2
  exit 1
fi
